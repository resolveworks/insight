{
	"name": "insight",
	"version": "0.3.0",
	"description": "Local-first P2P document search for journalists",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"samples": "bash scripts/fetch-samples.sh",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,html}": [
			"prettier --write"
		]
	},
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"marked": "^18.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.9",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	}
}
